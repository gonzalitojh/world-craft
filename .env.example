# Plantilla de variables de entorno de World Craft.
#
# Seguro de versionar: no contiene secretos reales. Copia este archivo a
# `.env.local` y rellena los valores en tu máquina:
#
#   cp .env.example .env.local        # macOS / Linux / Git Bash
#   Copy-Item .env.example .env.local # PowerShell
#
# `.env*` está en `.gitignore` salvo este archivo. No subas nunca valores
# reales al repositorio. Las variables opcionales pueden quedarse vacías: se
# tratan como ausentes.
#
# Los esquemas de validación viven en `src/lib/env/`:
#   - `public-schema.ts`: claves `NEXT_PUBLIC_*`, seguras en el navegador.
#   - `server-schema.ts`: claves solo de servidor, importadas desde
#     `src/lib/env/server.ts` (marcado con `server-only`).

# --- Público (se incrusta en el bundle del navegador) ---
# Origen canónico del sitio, sin barra final. En local y en las previews de
# Vercel puede quedarse vacío: se usa `VERCEL_URL` o `http://localhost:3000`.
NEXT_PUBLIC_SITE_URL=

# --- Solo servidor (nunca se expone al cliente) ---

# Entorno de ejecución: development | test | production.
NODE_ENV=development

# --- Supabase (M0-08, issue #9) ---
# Proyecto de desarrollo. Los valores reales se obtienen en el panel de Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo servidor. Nunca se expone al cliente ni se versiona.
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión de PostgreSQL (pooler transaccional, puerto 6543).
# La usa la aplicación en serverless; admite `prepare: false`.
DATABASE_URL=
# Cadena de conexión del tooling (pooler de sesión, puerto 5432).
# La usan migraciones, seed, reset y pruebas de RLS (`pnpm db:*`, `pnpm test:db`).
DIRECT_URL=
# Los nombres `*_ANON_KEY` y `*_SERVICE_ROLE_KEY` aceptan las claves actuales del
# panel de Supabase. M1-01 decidirá si se renombran.

# --- Cloudflare R2 (M0-10, issue #40) ---
# Bucket privado para assets. Las claves solo viven en el servidor.
# Crea un bucket de desarrollo y otro de producción (o prefijos separados);
# nunca reutilices las credenciales de producción en local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Opcional: solo si usas un endpoint S3-compatible distinto del de la cuenta.
R2_ENDPOINT=

# --- Almacenamiento local de desarrollo y pruebas (M0-10, issue #40) ---
# Driver efectivo: local | r2. Si se deja vacío, desarrollo/pruebas usan local
# cuando faltan credenciales de R2 y producción exige R2 (nunca cae a disco).
STORAGE_DRIVER=
# Directorio de objetos locales. Está en `.gitignore` junto con todo `.local/`.
STORAGE_LOCAL_DIR=.local/storage
# Origen de las URLs firmadas locales. Cámbialo si `next dev` usa otro puerto.
STORAGE_LOCAL_BASE_URL=http://localhost:3000
# Secreto HMAC de las URLs locales. Si se deja vacío, se genera la primera vez
# en `.local/storage-secret` con permisos restringidos.
STORAGE_LOCAL_SECRET=
# Token de `GET /api/storage/self-check` en preview/desarrollo. Mínimo 16
# caracteres; en producción la ruta devuelve 404 aunque exista.
STORAGE_SMOKE_TOKEN=

# --- Vercel ---
# La inyecta la plataforma en las previews y en producción; no las rellenes a
# mano. `src/lib/site-url.ts` usa `VERCEL_URL` para construir el origen del
# sitio y `/health` muestra los primeros caracteres de `VERCEL_GIT_COMMIT_SHA`.
# VERCEL_URL=your-project.vercel.app
# VERCEL_GIT_COMMIT_SHA=abc1234
