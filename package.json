{
  "name": "world-craft",
  "version": "0.1.0",
  "description": "Aplicación de escritorio local-first para construir mundos de ficción: fichas, relaciones, mapas y manuscrito.",
  "author": "World Craft contributors",
  "license": "MIT",
  "homepage": "https://github.com/gonzalitojh/world-craft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gonzalitojh/world-craft.git"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "licenses:sync": "node scripts/sync-licenses.mjs",
    "dist:dir": "electron-vite build && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "package:checksums": "node scripts/checksums.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:build": "node scripts/check-build.mjs",
    "verify:worker": "node scripts/check-transfer-worker.mjs",
    "verify:native": "node scripts/check-native.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.tests.json",
    "test:unit": "vitest run",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:audit": "pnpm build && playwright test tests/e2e/visual-audit.spec.ts",
    "test": "pnpm test:unit && pnpm test:components && pnpm test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "drizzle-kit": "^0.31.11",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "maplibre-gl": "6.20.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terra-draw": "1.40.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "better-sqlite3": "13.2.0",
    "builder-util-runtime": "9.7.0",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "6.8.11",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  }
}
