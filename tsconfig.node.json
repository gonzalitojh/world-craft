{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/updates/**/*.ts",
    "src/renderer/messages/**/*.ts",
    "src/renderer/i18n/create.ts",
    "src/renderer/i18n/formats.ts",
    "src/renderer/lib/recent-location.ts",
    "src/renderer/lib/world-mark.ts",
    "src/renderer/lib/entity-count.ts",
    "src/renderer/lib/entity-view-memory.ts",
    "src/renderer/lib/relation-groups.ts",
    "src/renderer/shell/views.ts",
    "src/renderer/shell/internal-views.ts",
    "tests/unit/**/*.ts",
    "tests/integration/**/*.ts",
    "electron.vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.components.config.ts",
    "vitest.integration.config.ts"
  ],
  "exclude": ["node_modules", "out"]
}
