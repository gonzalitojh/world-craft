{
  "$schema": "https://opencode.ai/config.json",
  // Guardrails comunes para todos los agentes de World Craft.
  // Las reglas se evalúan en orden y gana la última que coincide.
  "permissions": [
    // Rutas externas al proyecto: confirmación explícita. Evita que un
    // agente lea credenciales del usuario fuera del repositorio.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Publicación: siempre requiere confirmación explícita. Los patrones
    // amplios cubren opciones globales como `git --no-pager push` o
    // `gh --repo ... pr create`.
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "gh api *", "effect": "ask" },
    { "action": "shell", "resource": "git *push*", "effect": "ask" },
    { "action": "shell", "resource": "gh *pr create*", "effect": "ask" },
    { "action": "shell", "resource": "gh *pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "gh *api*", "effect": "ask" },

    // Git con -C/-c: confirmación. Evita rutas externas y configuración
    // inyectable en comandos que parecen de solo lectura.
    { "action": "shell", "resource": "git -C *", "effect": "ask" },
    { "action": "shell", "resource": "git -c *", "effect": "ask" },

    // Operaciones destructivas: confirmación explícita.
    { "action": "shell", "resource": "git reset --hard", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --merge", "effect": "ask" },
    { "action": "shell", "resource": "git reset --merge *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git branch --force *", "effect": "ask" },
    { "action": "shell", "resource": "git branch --delete *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -f *", "effect": "ask" },
    { "action": "shell", "resource": "git tag -d *", "effect": "ask" },
    { "action": "shell", "resource": "git tag --delete *", "effect": "ask" },
    { "action": "shell", "resource": "git remote remove *", "effect": "ask" },
    { "action": "shell", "resource": "git remote rm *", "effect": "ask" },
    { "action": "shell", "resource": "git worktree remove *", "effect": "ask" },
    { "action": "shell", "resource": "git submodule deinit *", "effect": "ask" },
    { "action": "shell", "resource": "gh release create *", "effect": "ask" },
    { "action": "shell", "resource": "gh release delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout * -- *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout .", "effect": "ask" },
    { "action": "shell", "resource": "git checkout ./*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -f *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout --force *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -B *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -p *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout --patch *", "effect": "ask" },
    { "action": "shell", "resource": "git switch -f *", "effect": "ask" },
    { "action": "shell", "resource": "git switch --force *", "effect": "ask" },
    { "action": "shell", "resource": "git switch --discard-changes *", "effect": "ask" },
    { "action": "shell", "resource": "git switch -C *", "effect": "ask" },
    { "action": "shell", "resource": "git switch --force-create *", "effect": "ask" },
    { "action": "shell", "resource": "git rm *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear", "effect": "ask" },
    { "action": "shell", "resource": "git update-index *", "effect": "ask" },
    { "action": "shell", "resource": "git update-ref *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *", "effect": "ask" },
    { "action": "shell", "resource": "ri *", "effect": "ask" },
    { "action": "shell", "resource": "del *", "effect": "ask" },
    { "action": "shell", "resource": "erase *", "effect": "ask" },
    { "action": "shell", "resource": "rd *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "Clear-Content *", "effect": "ask" },
    { "action": "shell", "resource": "Clear-Item *", "effect": "ask" },

    // Secretos: la herramienta de lectura pide confirmación para .env y
    // permite los ejemplos. Cualquier comando de shell que nombre .env
    // también pide confirmación, sea cual sea el lector.
    { "action": "read", "resource": "*.env*", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "**/.env*", "effect": "ask" },
    { "action": "read", "resource": "**/*.env*", "effect": "ask" },
    { "action": "read", "resource": "*.key", "effect": "ask" },
    { "action": "read", "resource": "**/*.key", "effect": "ask" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "**/*.pem", "effect": "ask" },
    { "action": "read", "resource": "*.p12", "effect": "ask" },
    { "action": "read", "resource": "**/*.p12", "effect": "ask" },
    { "action": "read", "resource": "*.pfx", "effect": "ask" },
    { "action": "read", "resource": "**/*.pfx", "effect": "ask" },
    { "action": "read", "resource": "*.keystore", "effect": "ask" },
    { "action": "read", "resource": "**/*.keystore", "effect": "ask" },
    { "action": "read", "resource": "*.jks", "effect": "ask" },
    { "action": "read", "resource": "**/*.jks", "effect": "ask" },
    { "action": "read", "resource": "*.cert", "effect": "ask" },
    { "action": "read", "resource": "**/*.cert", "effect": "ask" },
    { "action": "read", "resource": "*.crt", "effect": "ask" },
    { "action": "read", "resource": "**/*.crt", "effect": "ask" },
    { "action": "read", "resource": "*credentials.json", "effect": "ask" },
    { "action": "read", "resource": "**/*credentials.json", "effect": "ask" },
    { "action": "read", "resource": "*credentials.yml", "effect": "ask" },
    { "action": "read", "resource": "**/*credentials.yml", "effect": "ask" },
    { "action": "read", "resource": "*credentials.yaml", "effect": "ask" },
    { "action": "read", "resource": "**/*credentials.yaml", "effect": "ask" },
    { "action": "read", "resource": "*.credentials", "effect": "ask" },
    { "action": "read", "resource": "**/*.credentials", "effect": "ask" },
    { "action": "read", "resource": "*secrets.yml", "effect": "ask" },
    { "action": "read", "resource": "**/*secrets.yml", "effect": "ask" },
    { "action": "read", "resource": "*secrets.yaml", "effect": "ask" },
    { "action": "read", "resource": "**/*secrets.yaml", "effect": "ask" },
    { "action": "read", "resource": "*passwords.txt", "effect": "ask" },
    { "action": "read", "resource": "**/*passwords.txt", "effect": "ask" },
    { "action": "read", "resource": "*secrets.txt", "effect": "ask" },
    { "action": "read", "resource": "**/*secrets.txt", "effect": "ask" },
    { "action": "read", "resource": "*.git/config", "effect": "ask" },
    { "action": "read", "resource": "**/.git/config", "effect": "ask" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "ask" },
    { "action": "read", "resource": "*id_rsa*", "effect": "ask" },
    { "action": "read", "resource": "**/id_rsa*", "effect": "ask" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "ask" },
    { "action": "read", "resource": "**/id_ed25519*", "effect": "ask" },
    { "action": "read", "resource": "*id_ecdsa*", "effect": "ask" },
    { "action": "read", "resource": "**/id_ecdsa*", "effect": "ask" },
    { "action": "read", "resource": "*id_dsa*", "effect": "ask" },
    { "action": "read", "resource": "**/id_dsa*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/*.env.example", "effect": "allow" },

    // Opciones git que ejecutan comandos externos o escriben archivos.
    { "action": "shell", "resource": "git grep *-O*", "effect": "ask" },
    { "action": "shell", "resource": "git *--open-files-in-pager*", "effect": "ask" },
    { "action": "shell", "resource": "git *--ext-diff*", "effect": "ask" },
    { "action": "shell", "resource": "git *--textconv*", "effect": "ask" },
    { "action": "shell", "resource": "git *--output*", "effect": "ask" },
    { "action": "shell", "resource": "git *--no-index*", "effect": "ask" },
    { "action": "shell", "resource": "git grep *--untracked*", "effect": "ask" },

    // Stageo: todo git add o git stage pide confirmación; las formas
    // amplias de git add se deniegan para no mezclar archivos ajenos.
    { "action": "shell", "resource": "git add *", "effect": "ask" },
    { "action": "shell", "resource": "git stage *", "effect": "ask" },
    // El catch-all de .env va después de los ask generales y antes de los
    // deny de stageo amplio: así ninguna forma amplia degrada un deny.
    { "action": "shell", "resource": "*.env*", "effect": "ask" },
    { "action": "shell", "resource": "git add .", "effect": "deny" },
    { "action": "shell", "resource": "git add ./", "effect": "deny" },
    { "action": "shell", "resource": "git add ./*", "effect": "deny" },
    { "action": "shell", "resource": "git add -- .", "effect": "deny" },
    { "action": "shell", "resource": "git add -- ./*", "effect": "deny" },
    { "action": "shell", "resource": "git add -A*", "effect": "deny" },
    { "action": "shell", "resource": "git add --all*", "effect": "deny" },
    { "action": "shell", "resource": "git add -u*", "effect": "deny" },
    { "action": "shell", "resource": "git add --update*", "effect": "deny" },
    { "action": "shell", "resource": "git add -U*", "effect": "deny" },
    { "action": "shell", "resource": "git add -f .", "effect": "deny" },
    { "action": "shell", "resource": "git add -f ./*", "effect": "deny" },
    { "action": "shell", "resource": "git add -f*", "effect": "deny" },
    { "action": "shell", "resource": "git add --force .", "effect": "deny" },
    { "action": "shell", "resource": "git add --force ./*", "effect": "deny" },
    { "action": "shell", "resource": "git add --force*", "effect": "deny" },
    { "action": "shell", "resource": "git add -N .", "effect": "deny" },
    { "action": "shell", "resource": "git add -N ./*", "effect": "deny" },
    { "action": "shell", "resource": "git add --intent-to-add .", "effect": "deny" },
    { "action": "shell", "resource": "git add --intent-to-add ./*", "effect": "deny" },
    { "action": "shell", "resource": "git add --renormalize .", "effect": "deny" },
    { "action": "shell", "resource": "git add --renormalize ./*", "effect": "deny" },
    { "action": "shell", "resource": "git add -N *", "effect": "deny" },
    { "action": "shell", "resource": "git add --intent-to-add *", "effect": "deny" },
    { "action": "shell", "resource": "git add --renormalize *", "effect": "deny" },
    { "action": "shell", "resource": "git add :/", "effect": "deny" },
    { "action": "shell", "resource": "git add -- :/", "effect": "deny" },
    { "action": "shell", "resource": "git commit -a*", "effect": "ask" },
    { "action": "shell", "resource": "git commit --all*", "effect": "ask" },
    { "action": "shell", "resource": "git add :/*", "effect": "deny" },
    { "action": "shell", "resource": "git add -- :/*", "effect": "deny" },
    { "action": "shell", "resource": "git stage .", "effect": "deny" },
    { "action": "shell", "resource": "git stage ./", "effect": "deny" },
    { "action": "shell", "resource": "git stage ./*", "effect": "deny" },
    { "action": "shell", "resource": "git stage -- .", "effect": "deny" },
    { "action": "shell", "resource": "git stage -- ./*", "effect": "deny" },
    { "action": "shell", "resource": "git stage -A*", "effect": "deny" },
    { "action": "shell", "resource": "git stage --all*", "effect": "deny" },
    { "action": "shell", "resource": "git stage -u*", "effect": "deny" },
    { "action": "shell", "resource": "git stage --update*", "effect": "deny" },
    { "action": "shell", "resource": "git stage -U*", "effect": "deny" },
    { "action": "shell", "resource": "git stage -f*", "effect": "deny" },
    { "action": "shell", "resource": "git stage -N *", "effect": "deny" },
    { "action": "shell", "resource": "git stage --intent-to-add *", "effect": "deny" },
    { "action": "shell", "resource": "git stage --renormalize *", "effect": "deny" },
    { "action": "shell", "resource": "git stage --force .", "effect": "deny" },
    { "action": "shell", "resource": "git stage --force ./*", "effect": "deny" },
    { "action": "shell", "resource": "git stage --force*", "effect": "deny" },
    { "action": "shell", "resource": "git stage :/*", "effect": "deny" },
    { "action": "shell", "resource": "git stage -- :/*", "effect": "deny" }
  ]
}
